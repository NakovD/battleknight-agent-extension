# Base URL of the BattleKnight agent API (api/ in this repo), without a trailing slash.
# Not a secret. Applies to every build mode, including `vite build`, which is what
# gets loaded into the browser — override it in .env.production once a deployed API exists.
#
# Run the API with its "http" launch profile: the "https" profile redirects plain HTTP,
# and a redirected CORS preflight is rejected by the browser.
VITE_API_BASE_URL=http://localhost:5224
